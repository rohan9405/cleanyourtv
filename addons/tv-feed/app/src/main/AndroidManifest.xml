<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Posters (most apps publish https links) and IMDb ratings from OMDb. The launcher itself stays offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Continue watching and the apps' recommendation rows (docs/watch-next.md). Asked on the Feed screen,
         or granted with: pm grant io.github.rohan9405.feed android.permission.READ_TV_LISTINGS -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />

    <queries>
        <provider android:authorities="android.media.tv" />
        <!-- App names for the row titles ("YouTube · Trending"). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <!-- The launcher's feed_package key names this package; this meta-data names the provider it reads. -->
        <meta-data android:name="com.gathin.tvhome.feed" android:value="io.github.rohan9405.feed" />

        <!-- Exported so the launcher can read it, but it answers only apps signed with this app's key
             (FeedProvider.allowed), since the rows show what you watch. -->
        <provider
            android:name=".FeedProvider"
            android:authorities="io.github.rohan9405.feed"
            android:exported="true" />

        <activity
            android:name=".FeedActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>
    </application>
</manifest>
