<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- No permissions: the pictures come in over ADB through FilesProvider and stay on the TV. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- `settings put secure screensaver_components com.gathin.photodream/.PhotoDream` (sync.sh does it). -->
        <service
            android:name=".PhotoDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- sync.sh writes the pictures through this: on TCL G10 a file the shell copies into Android/data
             belongs to the shell and the app gets EACCES reading it. WRITE_SECURE_SETTINGS: the adb shell has
             it, ordinary apps don't. -->
        <provider
            android:name=".FilesProvider"
            android:authorities="com.gathin.photodream.files"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
    </application>
</manifest>
